{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LanHelp chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride":     { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image":         { "type": "object", "required": ["repository"], "properties": { "repository": { "type": "string" } } },
    "imagePullSecrets": { "type": "array" },
    "web":           { "type": "object" },
    "worker":        { "type": "object" },
    "migrations":    { "type": "object" },
    "service":       { "type": "object" },
    "ingress":       { "type": "object" },
    "lancore": {
      "type": "object",
      "required": ["appSlug"],
      "properties": {
        "appSlug": { "type": "string", "const": "lanhelp" }
      }
    },
    "staffEmail":    { "type": "string" },
    "database":      { "type": "object" },
    "cache":         { "type": "object" },
    "mail":          { "type": "object" },
    "configMap":     { "type": "object" },
    "appSecrets":    { "type": "object" },
    "serviceAccount":          { "type": "object" },
    "podSecurityContext":       { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "podAnnotations":           { "type": "object" },
    "nodeSelector":             { "type": "object" },
    "tolerations":              { "type": "array" },
    "affinity":                 { "type": "object" },
    "networkPolicy":            { "type": "object" },
    "serviceMonitor":           { "type": "object" },
    "prometheusRule":           { "type": "object" },
    "global":                   { "type": "object" }
  }
}
