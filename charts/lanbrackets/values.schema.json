{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LanBrackets chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride":     { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "port":       { "type": "integer" }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "web": {
      "type": "object",
      "properties": {
        "enabled":      { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "roleEnv":      { "type": "string", "enum": ["web", "worker", "all"] },
        "skipMigrate":  { "type": "string", "enum": ["0", "1"] },
        "resources":    { "type": "object" },
        "hpa":          { "type": "object" },
        "pdb":          { "type": "object" }
      }
    },
    "worker":      { "type": "object" },
    "migrations":  { "type": "object" },
    "service":     { "type": "object" },
    "ingress":     { "type": "object" },
    "lancore": {
      "type": "object",
      "required": ["appSlug"],
      "properties": {
        "appSlug": { "type": "string", "const": "lanbrackets" },
        "satellite": { "type": "object" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "driver":        { "type": "string", "enum": ["pgsql"] },
        "createCluster": { "type": "boolean" }
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "driver":         { "type": "string", "enum": ["dragonfly", "redis"] },
        "createInstance": { "type": "boolean" }
      }
    },
    "writablePublic": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["emptyDir", "rwx-pvc"] },
        "size": { "type": "string" }
      }
    },
    "mail":       { "type": "object" },
    "configMap":  { "type": "object" },
    "appSecrets": { "type": "object" },
    "serviceAccount":          { "type": "object" },
    "podSecurityContext":       { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "podAnnotations":           { "type": "object" },
    "nodeSelector":             { "type": "object" },
    "tolerations":              { "type": "array" },
    "affinity":                 { "type": "object" },
    "networkPolicy":            { "type": "object" },
    "serviceMonitor":           { "type": "object" },
    "prometheusRule":           { "type": "object" },
    "global":                   { "type": "object" }
  }
}
