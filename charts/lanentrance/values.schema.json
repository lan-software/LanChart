{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LanEntrance chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride":     { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "port":       { "type": "integer" }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "web":           { "type": "object" },
    "worker":        { "type": "object" },
    "migrations":    { "type": "object" },
    "service":       { "type": "object" },
    "ingress":       { "type": "object" },
    "lancore": {
      "type": "object",
      "required": ["appSlug"],
      "properties": {
        "appSlug": { "type": "string", "const": "lanentrance" }
      }
    },
    "jwks": {
      "type": "object",
      "properties": {
        "endpoint":         { "type": "string" },
        "cacheTtlSeconds":  { "type": "integer", "minimum": 0 },
        "bootstrapSecret":  { "type": "object" }
      }
    },
    "database":     { "type": "object" },
    "cache":        { "type": "object" },
    "mail":         { "type": "object" },
    "configMap":    { "type": "object" },
    "appSecrets":   { "type": "object" },
    "serviceAccount":          { "type": "object" },
    "podSecurityContext":       { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "podAnnotations":           { "type": "object" },
    "nodeSelector":             { "type": "object" },
    "tolerations":              { "type": "array" },
    "affinity":                 { "type": "object" },
    "networkPolicy":            { "type": "object" },
    "serviceMonitor":           { "type": "object" },
    "prometheusRule":           { "type": "object" },
    "global":                   { "type": "object" }
  }
}
